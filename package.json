{
  "name": "aether-chess",
  "version": "1.0.0",
  "type": "module",
  "description": "国际象棋引擎:JS 参照实现(零依赖、无 DOM,Node 与 Worker 通用)+ Zig/wasm 移植通道(zig 分支);PVS/TT/静态搜索 + Texel 调参的 491 参数 HCE 评估",
  "main": "src/ai.js",
  "exports": {
    ".": "./src/ai.js",
    "./rules": "./src/rules.js",
    "./ai": "./src/ai.js",
    "./book": "./src/book.js",
    "./eval": "./src/eval.js",
    "./worker": "./src/worker.js",
    "./wasm": "./wasm/chess.wasm"
  },
  "scripts": {
    "test": "node test/engine-test.mjs",
    "test:quick": "node test/engine-test.mjs --quick",
    "test:book": "node test/book-test.mjs",
    "test:worker": "node tools/worker-test.mjs",
    "selftest": "zig build selftest",
    "test:zig": "zig build test",
    "build:wasm": "node tools/build-wasm.mjs",
    "probe:wasm": "node tools/probe-wasm.mjs",
    "gen:params": "node tools/gen-params.mjs"
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/suulnnka/AetherChess.git"
  },
  "keywords": [
    "chess",
    "engine",
    "pvs",
    "evaluation",
    "texel-tuning"
  ],
  "private": false
}
